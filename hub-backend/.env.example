DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[db-name]"

AUTH_SECRET=""

INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-this-password"
INITIAL_ADMIN_NAME="Administrator"

# almacenamiento de archivos adjuntos del proyecto
# MinIO es el predeterminado para el desarrollo
# se usa STORAGE_DRIVER="local" para volver usar el disco local
STORAGE_DRIVER="s3"
# este es el path absoluto para el controlador local, por defecto es <backend>/uploads cuando está vacío
UPLOAD_DIR=""
MAX_FILE_SIZE_BYTES="10485760"

# configuración de MinIO para desarrollo local
# desde dentro de Docker/Dev Container el host es "minio"; desde el host usar
# http://localhost:9000.
S3_ENDPOINT="http://minio:9000"
S3_BUCKET="capstonehub"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
