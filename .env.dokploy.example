# Variables para el despliegue en Dokploy (compose.dokploy.yml).
# Cópialas en Dokploy > tu Compose > pestaña Environment y reemplaza los valores.

# Base de datos: servicio de base de datos de Dokploy (host interno en
# `dokploy-network`). El backend lo usa vía DATABASE_URL.
DATABASE_URL="postgresql://postgres:change-this-password@<servicio-db>:5432/capstonehub"

# Backend
# Debe ser una cadena aleatoria de al menos 32 caracteres.
AUTH_SECRET="change-this-to-a-long-random-secret"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-this-password"
INITIAL_ADMIN_NAME="Administrator"
MAX_FILE_SIZE_BYTES="10485760"
MAX_REPORT_FILE_SIZE_BYTES="104857600"
# En producción se recomienda dejar Swagger deshabilitado.
SWAGGER_ENABLED="false"

# Almacenamiento (MinIO incluido en el compose)
S3_BUCKET="capstonehub"
S3_ACCESS_KEY="change-this-access-key"
S3_SECRET_KEY="change-this-secret-key"
S3_REGION="us-east-1"
S3_UPLOAD_URL_TTL_SECONDS="900"
# Host público de MinIO que alcanza el navegador; debe coincidir con el dominio
# que le asignes al servicio `minio` (p. ej. https://minio.example.com).
S3_PUBLIC_ENDPOINT="https://minio.example.com"
# Origen permitido por CORS para las subidas directas (dominio del frontend).
S3_CORS_ORIGINS="https://app.example.com"

# Imágenes publicadas por el workflow `release` (opcional; los defaults apuntan
# a GHCR). La ruta incluye el repo: ghcr.io/<owner>/<repo>/capstonehub-*.
# Fija un tag concreto (sha-… o versión) para despliegues reproducibles.
# BACKEND_IMAGE="ghcr.io/iscoutb/capstonehub/capstonehub-backend:latest"
# FRONTEND_IMAGE="ghcr.io/iscoutb/capstonehub/capstonehub-frontend:latest"
